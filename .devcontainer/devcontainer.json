{
  "name": "UNO Multiplayer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3000, 4000],
  "portsAttributes": {
    "4000": {
      "label": "Backend (Socket.IO)",
      "requireLocalPort": false,
      "protocol": "https",
      "visibility": "public"
    },
    "3000": {
      "label": "Frontend (React)",
      "requireLocalPort": false,
      "protocol": "https",
      "visibility": "public"
    }
  },
  "postCreateCommand": "npm install"
}
